APP_NAME="FoodLoop AI Service"
APP_ENV="production" # options: test, development, production
APP_VERSION="1.0.0"

# =========================
# LLM - SambaNova / OpenAI Compatible
# =========================
OPENAI_API_KEY="<your-production-sambanova-api-key>"
OPENAI_BASE_URL="https://api.sambanova.ai/v1"
OPENAI_MODEL="gemma-2-27b-it"
OPENAI_TIMEOUT_SECONDS=30.0

# =========================
# Embeddings - Local BGE-M3 (1024-d, Multilingual)
# =========================
EMBEDDING_PROVIDER="local_bge_m3" # options: local_bge_m3, openai, fake
EMBEDDING_MODEL="BAAI/bge-m3"
EMBEDDING_VECTOR_SIZE=1024
EMBEDDING_DEVICE="cpu" # options: cpu, cuda

# =========================
# Vector Store - Production Qdrant
# =========================
VECTOR_STORE_PROVIDER="qdrant" # options: memory (dev/test), qdrant (prod)
QDRANT_URL="http://localhost:6333" # or production Qdrant cloud/cluster endpoint
QDRANT_API_KEY="" # optional production Qdrant API key
QDRANT_COLLECTION_NAME="foodloop_pricing_knowledge_bge_m3"
QDRANT_VECTOR_SIZE=1024
QDRANT_TIMEOUT_SECONDS=10.0

# =========================
# Retrieval & Ingestion Batch Limits
# =========================
PRICING_RETRIEVAL_TOP_K=5
MAX_PRICING_BATCH_SIZE=50
HISTORICAL_INGESTION_MAX_BATCH_SIZE=100

# =========================
# Weather Provider (Open-Meteo)
# =========================
WEATHER_PROVIDER="open_meteo" # options: mock, open_meteo
WEATHER_API_BASE_URL="https://api.open-meteo.com/v1/forecast"
WEATHER_API_KEY="" # optional commercial customer API key
WEATHER_API_TIMEOUT_SECONDS=5.0

# =========================
# Holidays / Events Provider (Nager.Date)
# =========================
EVENTS_PROVIDER="nager_date" # options: mock, nager_date
HOLIDAY_API_BASE_URL="https://date.nager.at/api/v4"
HOLIDAY_API_TIMEOUT_SECONDS=5.0
DEFAULT_COUNTRY_CODE="EG"
